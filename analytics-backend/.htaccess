# Redirecionar HTTP → HTTPS
# A Locaweb usa load balancer — verificar pelo header X-Forwarded-Proto
RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Desabilitar listagem de diretório
Options -Indexes

# Bloquear acesso direto ao diretório de dados
<IfModule mod_authz_core.c>
  <DirectoryMatch "data">
    Require all denied
  </DirectoryMatch>
</IfModule>
